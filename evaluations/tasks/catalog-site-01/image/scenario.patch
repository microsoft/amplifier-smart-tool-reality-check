+def install_command(repository, path):
+    """The `uv tool install` command for a tool, from a subdirectory when its repository holds several tools."""
+    if path == '.':
+        return f'uv tool install git+{repository}'
+    return f'uv tool install "git+{repository}#subdirectory={path}"'
