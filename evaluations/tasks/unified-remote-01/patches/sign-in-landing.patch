+def landing_url(request: web.Request, next_path: str | None) -> str:
+    """Absolute address of the app on this host's own listener, where a completed sign-in lands."""
+    scheme = "https" if request.secure else "http"
+    return f"{scheme}://127.0.0.1:{request.app['server_config']['port']}{validate_next_path(next_path)}"
